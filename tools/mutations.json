{
  "_comment": [
    "Mutations applied by tools/mutate.py. Each entry corrupts one fact the",
    "decoder depends on; the suite is expected to notice. An entry reported as",
    "SURVIVED names a fact no test currently constrains -- that is a missing",
    "vector, not a passing grade.",
    "",
    "Keep 'find' strings anchored enough to match exactly once. mutate.py",
    "fails the run if a pattern matches zero times or more than once, so a",
    "refactor that silently stops applying a mutation is caught rather than",
    "quietly reported as killed."
  ],

  "mutations": [
    {
      "label": "crc: polynomial 0x07 -> 0x06",
      "file": "src/core/include/espi/Crc8.h",
      "find": "kPolynomial = 0x07",
      "replace": "kPolynomial = 0x06",
      "tests": "test_crc"
    },
    {
      "label": "crc: seed 0x00 -> 0xFF",
      "file": "src/core/include/espi/Crc8.h",
      "find": "kSeed = 0x00",
      "replace": "kSeed = 0xFF",
      "tests": "test_crc"
    },
    {
      "label": "lanes: reverse bit order within a clock",
      "file": "src/core/include/espi/LaneCodec.h",
      "find": "return 7 - group * bits_per_clock - ( bits_per_clock - 1 ) + lane_offset;",
      "replace": "return 7 - group * bits_per_clock - lane_offset;",
      "tests": "test_lanes"
    },
    {
      "label": "lanes: emit groups LSB-first instead of MSB-first",
      "file": "src/core/include/espi/LaneCodec.h",
      "find": "return 7 - group * bits_per_clock - ( bits_per_clock - 1 ) + lane_offset;",
      "replace": "return group * bits_per_clock + lane_offset;",
      "tests": "test_lanes"
    },
    {
      "label": "lanes: single-mode response on IO[0] instead of IO[1]",
      "file": "src/core/include/espi/IoMode.h",
      "find": "phase == Phase::Command ? 0 : 1",
      "replace": "phase == Phase::Command ? 0 : 0",
      "tests": "test_lanes"
    },
    {
      "label": "lanes: dual mode treated as 4 bits per clock",
      "file": "src/core/include/espi/IoMode.h",
      "find": "return mode == IoMode::Single ? 1 : ( mode == IoMode::Dual ? 2 : 4 );",
      "replace": "return mode == IoMode::Single ? 1 : 4;",
      "tests": "test_lanes"
    },
    {
      "label": "timing: TAR 2 clocks -> 1 clock",
      "file": "src/core/include/espi/IoMode.h",
      "find": "kTurnAroundClocks = 2",
      "replace": "kTurnAroundClocks = 1",
      "tests": "test_lanes"
    },
    {
      "label": "opcode: GET_VWIRE 0x05 -> 0x15",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( GET_VWIRE, 0x05, 0xFF, VirtualWire, false )",
      "replace": "X( GET_VWIRE, 0x15, 0xFF, VirtualWire, false )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: GET_CONFIGURATION 0x21 -> 0x31",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( GET_CONFIGURATION, 0x21, 0xFF, ChannelIndependent, false )",
      "replace": "X( GET_CONFIGURATION, 0x31, 0xFF, ChannelIndependent, false )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: swap PUT_PC and GET_PC encodings",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( PUT_PC, 0x00, 0xFF, Peripheral, false )",
      "replace": "X( PUT_PC, 0x01, 0xFF, Peripheral, false )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: short-cycle base 0x40 -> 0x41 (9-bit misread)",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( PUT_IORD_SHORT, 0x40, 0xFC, Peripheral, true )",
      "replace": "X( PUT_IORD_SHORT, 0x41, 0xFC, Peripheral, true )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: short-cycle mask 0xFC -> 0xFF (C1C0 ignored)",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( PUT_IOWR_SHORT, 0x44, 0xFC, Peripheral, true )",
      "replace": "X( PUT_IOWR_SHORT, 0x44, 0xFF, Peripheral, true )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: C1C0 length 01b -> 3 bytes",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( 0x1, 2 )",
      "replace": "X( 0x1, 3 )",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: C1C0 reserved 10b given a length",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( 0x2, 0 ) /* Reserved */",
      "replace": "X( 0x2, 3 ) /* Reserved */",
      "tests": "test_opcodes"
    },
    {
      "label": "opcode: channel of GET_OOB mislabelled",
      "file": "src/core/tables/Opcodes.h",
      "find": "X( GET_OOB, 0x07, 0xFF, Oob, false )",
      "replace": "X( GET_OOB, 0x07, 0xFF, Flash, false )",
      "tests": "test_opcodes"
    },

    {
      "label": "response: ACCEPT code 1000b -> 1001b",
      "file": "src/core/tables/Responses.h",
      "find": "X( ACCEPT, 0x8 )",
      "replace": "X( ACCEPT, 0x9 )",
      "tests": "test_link"
    },
    {
      "label": "response: WAIT_STATE code 1111b -> 1110b",
      "file": "src/core/tables/Responses.h",
      "find": "X( WAIT_STATE, 0xF )",
      "replace": "X( WAIT_STATE, 0xE )",
      "tests": "test_link"
    },
    {
      "label": "response: NON_FATAL_ERROR code 0010b -> 0100b",
      "file": "src/core/tables/Responses.h",
      "find": "X( NON_FATAL_ERROR, 0x2 )",
      "replace": "X( NON_FATAL_ERROR, 0x4 )",
      "tests": "test_link"
    },
    {
      "label": "response: NO_RESPONSE byte FFh -> FEh",
      "file": "src/core/tables/Responses.h",
      "find": "#define ESPI_RESPONSE_NO_RESPONSE_BYTE 0xFF",
      "replace": "#define ESPI_RESPONSE_NO_RESPONSE_BYTE 0xFE",
      "tests": "test_link"
    },
    {
      "label": "response: virtual wire append modifier 10b -> 01b",
      "file": "src/core/tables/Responses.h",
      "find": "X( 0x2, \"Virtual Wire (channel 1) packet appended\" )",
      "replace": "X( 0x1, \"Virtual Wire (channel 1) packet appended\" )",
      "tests": "test_link"
    },

    {
      "label": "status: PC_FREE moved off bit 0",
      "file": "src/core/tables/Status.h",
      "find": "X( PC_FREE, 0 )",
      "replace": "X( PC_FREE, 4 )",
      "tests": "test_link"
    },
    {
      "label": "status: FLASH_C_FREE at bit 15 (the mis-extracted layout)",
      "file": "src/core/tables/Status.h",
      "find": "X( FLASH_C_FREE, 8 )",
      "replace": "X( FLASH_C_FREE, 15 )",
      "tests": "test_link"
    },
    {
      "label": "status: swap VWIRE_AVAIL and OOB_AVAIL",
      "file": "src/core/tables/Status.h",
      "find": "X( VWIRE_AVAIL, 6 )",
      "replace": "X( VWIRE_AVAIL, 7 )",
      "tests": "test_link"
    },
    {
      "label": "status: reserved mask 11:10,15:14 -> 15:12",
      "file": "src/core/tables/Status.h",
      "find": "#define ESPI_STATUS_RESERVED_MASK 0xCC00u",
      "replace": "#define ESPI_STATUS_RESERVED_MASK 0xF000u",
      "tests": "test_link"
    },

    {
      "label": "shape: GET_CONFIGURATION response loses its data DWord",
      "file": "src/core/tables/PacketShapes.h",
      "find": "X( GET_CONFIGURATION, ESPI_CMD( Addr16 ), ESPI_RSP( Data32, Status16 ) )",
      "replace": "X( GET_CONFIGURATION, ESPI_CMD( Addr16 ), ESPI_RSP( Status16 ) )",
      "tests": "test_link"
    },
    {
      "label": "shape: SET_CONFIGURATION data moved to the response phase",
      "file": "src/core/tables/PacketShapes.h",
      "find": "X( SET_CONFIGURATION, ESPI_CMD( Addr16, Data32 ), ESPI_RSP( Status16 ) )",
      "replace": "X( SET_CONFIGURATION, ESPI_CMD( Addr16 ), ESPI_RSP( Data32, Status16 ) )",
      "tests": "test_link"
    },
    {
      "label": "shape: GET_VWIRE response loses its virtual wire packet",
      "file": "src/core/tables/PacketShapes.h",
      "find": "X( GET_VWIRE, ESPI_CMD(), ESPI_RSP( VwirePacket, Status16 ) )",
      "replace": "X( GET_VWIRE, ESPI_CMD(), ESPI_RSP( Status16 ) )",
      "tests": "test_link"
    },
    {
      "label": "shape: GET_STATUS given a spurious address field",
      "file": "src/core/tables/PacketShapes.h",
      "find": "X( GET_STATUS, ESPI_CMD(), ESPI_RSP( Status16 ) )",
      "replace": "X( GET_STATUS, ESPI_CMD( Addr16 ), ESPI_RSP( Status16 ) )",
      "tests": "test_link"
    }
  ]
}
